# 複製這個檔案成 .env，填入自己的值。.env 不要交、不要上傳。
PORT=3000

# 你自己申請的 Gemini API Key（A3-7 教過怎麼申請）
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# FHIR Server。聯測（C 聯測模擬）用 TW Core 官方測試伺服器，內建 TW Core IG 驗證器。
# 連不上時可暫時換回 https://hapi.fhir.org/baseR4（只換這一行，前端改從後端讀，不用再改 DoctorView.vue）。
FHIR_BASE_URL=https://twcore.hapi.fhir.tw/fhir
# 老師依講義驗收時可改用 https://hapi.fhir.tw/fhir：那台沒有 TW Core Profile，$validate 只驗基本 FHIR；一般使用與聯測都建議維持上面那台。

# 醫事人員證書字號、病歷號的 identifier.system。TW Core IG 沒有指定，Track 若有規定就照 Track 改。
# MEDICAL_LICENSE_SYSTEM=https://ma.mohw.gov.tw
# MEDICAL_RECORD_SYSTEM=https://www.tph.mohw.gov.tw

# 聯測匯入（④ 匯入 JSON）上傳前用官方 validator_cli 驗 TW Core 1.0.0：需要 Java 17。PATH 上的 java 不是 17 時設 JAVA_HOME；jar 不在 tools/ 時設 VALIDATOR_JAR
# JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home
# VALIDATOR_JAR=

# CDS Hooks：除了 FHIR_BASE_URL 之外，還信任哪些 EHR 送來的 fhirServer（逗號分隔）
# CDS_TRUSTED_FHIR_SERVERS=https://launch.smarthealthit.org/v/r4/fhir

# LINE：Token 留空就只在終端機印「模擬 LINE 通知」。
# 要真的送，兩個都要填：Channel access token，和收通知的醫師 userId（LINE Developers 後台或 webhook 拿得到）。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_DOCTOR_USER_ID=

# 聯測松 Level I：所有賽道都要先用 OAuth 2.0 Client Credentials 向大會 Keycloak 取 token，才能打 FHIR 主機。
# 三個都留空就不啟用（本機 mock、公開測試伺服器不用）。client_secret 聯測規定一律是 secret，用 HTTP Basic 送。
# OAUTH_TOKEN_URL=https://keycloak.example/realms/twcat/protocol/openid-connect/token
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=secret
# OAUTH_SCOPE=twcore
